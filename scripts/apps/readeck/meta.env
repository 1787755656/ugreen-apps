APP_ID=com.personal.readeck
PROJECT_DIR=apps/readeck/com.personal.readeck
FILE_PREFIX=readeck
RELEASE_TITLE="Readeck"
HOMEPAGE_URL="https://readeck.org/"
SUPPORTED_ARCH="amd64 arm64"
# 上游在 Codeberg（https://codeberg.org/readeck/readeck），GitHub 的
# readeck/readeck 只是镜像且【没有 Releases】（tags 也只同步到 0.3.x）。
# 所以版本探测走 Codeberg API（见 get-latest-version.sh），更新说明从
# Codeberg 上的 CHANGELOG.md 按版本号切出（fetch-changelog-section.sh）。
# 不设 UPSTREAM_GITHUB：GitHub 镜像没有 release body，fetch-upstream-notes.sh
# 拿不到东西；设了反而会让 Release 正文出现一个指向 GitHub 旧版/404 的链接。
CHANGELOG_URL="https://codeberg.org/readeck/readeck/raw/branch/main/CHANGELOG.md"
CHANGELOG_HTML_URL="https://codeberg.org/readeck/readeck/src/branch/main/CHANGELOG.md"
