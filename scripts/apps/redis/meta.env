APP_ID=com.personal.redis
PROJECT_DIR=apps/redis/com.personal.redis
FILE_PREFIX=redis
RELEASE_TITLE="Redis"
HOMEPAGE_URL="https://redis.io"
SUPPORTED_ARCH="amd64 arm64"
# redis/redis 不发 GitHub Release 正文，fetch-upstream-notes 拿不到内容是预期
# —— 这个字段只用来在 Release 说明里给出上游仓库链接。
UPSTREAM_GITHUB=redis/redis

# 首发钉在真机验证过的版本（独立工程时期打到 8.10.0.0005，索引里同时还有
# 8.10.1/8.10.2）。删掉这一行即恢复自动跟踪 8.x 最新版。
# 数据库应用采用"先真机、再放行"的保守策略，理由同 MariaDB。
PINNED_VERSION=8.10.0
