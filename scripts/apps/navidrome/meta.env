APP_ID=com.personal.navidrome
PROJECT_DIR=apps/navidrome/com.personal.navidrome
FILE_PREFIX=navidrome
RELEASE_TITLE="Navidrome 音乐服务器"
SUPPORTED_ARCH="amd64 arm64"
HOMEPAGE_URL=https://www.navidrome.org
UPSTREAM_GITHUB=navidrome/navidrome
# 本应用是本地开发打包：官方发行二进制 + 本机 jellyfin-ffmpeg 素材 + Go launcher
# 都在本机组装（build.sh 依赖本机素材路径），Release 由本机上传
# （build.sh → gh release create → 刷 catalog），CI 不参与自动构建。
# 不设这个开关的话，每天 08:00 的 schedule 会尝试重建并必然失败。
CI_SKIP=1
