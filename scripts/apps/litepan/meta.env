APP_ID=com.ponphil.litepan
PROJECT_DIR=apps/litepan/com.ponphil.litepan
FILE_PREFIX=litepan
RELEASE_TITLE="LitePan"
HOMEPAGE_URL="https://www.litepan.top"
SUPPORTED_ARCH="amd64 arm64"
# 上游 Go 版只发 Docker 镜像，GitHub 上【没有 Release】、tag 也停在 v0.3.0-beta
# （当前是 v0.4.6-Beta）。所以 fetch-upstream-notes.sh 注定拿不到正文；这里仍设
# UPSTREAM_GITHUB 是为了让 Release 正文里有「上游仓库」这一行链接 —— 拿不到正文时
# reusable-build-app.yml 会自己把那个指向具体 tag 的链接清掉，不会留下 404。
# 上游也没有 CHANGELOG.md，所以不设 CHANGELOG_URL。
UPSTREAM_GITHUB="Ponphil/LitePan"
