APP_ID=com.personal.ugtheme
PROJECT_DIR=apps/ugtheme/com.personal.ugtheme
FILE_PREFIX=ugtheme
RELEASE_TITLE="主题美化中心 (Theme Studio)"
SUPPORTED_ARCH="amd64 arm64"
HOMEPAGE_URL=https://club.ugnas.com/home.php?mod=space&uid=10131
# 自研应用，无上游仓库：不设 UPSTREAM_GITHUB（设了 Release 正文里只会多一条 404 链接）。
# store 分类枚举里的 utility —— 图标/壁纸美化工具，不属于 system/media/download/ai。
CATALOG_CATEGORY=utility
# 本应用是本地开发的自研应用：镜像与 upk 都在本机打包，Release 由本机上传
# （build.sh → gh release create → 刷 catalog），CI 不参与自动构建。
# 不设这个开关的话，每天 08:00 的 schedule 会尝试重建并必然失败（它去下载
# ugtheme-img/<版本> 的镜像 tar，而那些 tar 从不进仓库）。
CI_SKIP=1
