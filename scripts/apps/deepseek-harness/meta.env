APP_ID=com.personal.deepseekharness
PROJECT_DIR=apps/deepseek-harness/com.personal.deepseekharness
FILE_PREFIX=deepseek-harness
RELEASE_TITLE="DeepSeek Harness"
SUPPORTED_ARCH="amd64 arm64"
# release 步骤抓上游更新说明用：镜像版本与 DSH 官方 release 一一对应
# （tag 形如 dsh-v0.2.1-rc.4）。镜像打包仓库 smanx/deepseek-harness-docker
# 本身无 release，所以指向 DSH 官方仓库。
UPSTREAM_GITHUB=deepseek-ai/deepseek-harness
HOMEPAGE_URL=https://hub.docker.com/r/smanx/deepseek-harness
