APP_ID=com.personal.randomvideo
PROJECT_DIR=apps/randomvideo/com.personal.randomvideo
FILE_PREFIX=randomvideo
RELEASE_TITLE="随机视频 Random Video"
HOMEPAGE_URL=""
SUPPORTED_ARCH="amd64 arm64"
# 纯自研应用，无第三方上游：版本随本项目 project.yaml 手工 bump，
# get-latest-version.sh 直接读它的 version: 字段（不探测任何外部版本源）。
# 后端 randomvideo_serv 是纯标准库 Go 单二进制（零外部依赖），前端编译期内嵌进
# 二进制，同时由网关从 rootfs_common/www 提供——两者由 build.sh 保持同源。
