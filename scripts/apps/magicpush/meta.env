APP_ID=com.magiccode.magicpush
PROJECT_DIR=apps/magicpush/com.magiccode.magicpush
FILE_PREFIX=magicpush
RELEASE_TITLE="MagicPush"
HOMEPAGE_URL="https://github.com/magiccode1412/magicpush"
SUPPORTED_ARCH="amd64 arm64"
# 上游没有 GitHub Release、也没有 tag（见 get-latest-version.sh），所以
# fetch-upstream-notes.sh 永远拿不到东西。更新说明只存在于这个文件里，
# 由 fetch-changelog-section.sh 按版本号切出对应小节写进 Release 正文。
CHANGELOG_URL="https://raw.githubusercontent.com/magiccode1412/magicpush/main/CHANGELOG.md"
CHANGELOG_HTML_URL="https://github.com/magiccode1412/magicpush/blob/main/CHANGELOG.md"
