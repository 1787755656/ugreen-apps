APP_ID=com.personal.chromium
PROJECT_DIR=apps/chromium/com.personal.chromium
FILE_PREFIX=chromium
RELEASE_TITLE="Chromium 浏览器"
SUPPORTED_ARCH="amd64 arm64"
HOMEPAGE_URL=https://github.com/jlesage/docker-chromium
UPSTREAM_GITHUB=jlesage/docker-chromium
# 本应用是本地开发打包：上游官方镜像 jlesage/chromium:v<ver> 双架构 docker save
# + 本机 ugcli pack，Release 由本机上传（gh release upload → 刷 catalog），
# CI 不参与自动构建。不设这个开关的话，每天 08:00 的 schedule 会尝试重建并必然失败。
CI_SKIP=1
