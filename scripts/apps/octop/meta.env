APP_ID=com.tencent.octop
PROJECT_DIR=apps/octop/com.tencent.octop
FILE_PREFIX=octop
RELEASE_TITLE="Octop AI 助手平台"
HOMEPAGE_URL="https://github.com/TencentCloud/Octop"
SUPPORTED_ARCH="arm64"
UPSTREAM_GITHUB=TencentCloud/Octop

# 商店目录分类覆盖（ugos-store：ai/media/automation/download/content/network/system/browser）
# project.yaml 的 tag_types 是 utility（映射成 system），但 Octop 是 AI 助手平台，
# 归到 ai 分类更好找。
CATALOG_CATEGORY=ai

# 只出 arm64：上游对每个版本发布【两个】fnOS native fpk ——
#   Octop-fnos-native-<ver>.fpk        通用版，site-packages 是 x86_64
#   Octop-fnos-native-arm64-<ver>.fpk  arm64 版，site-packages 是 aarch64
# build.sh 那边 amd64 分支也写好了（取通用版 + x86_64 PBS python），
# 但通用版 fpk 里的 .so 到底是 x86-64 还是混了别的架构，只在 b5 上核实过、
# 没在每个版本上核实 —— 真要用 x86 时把 SUPPORTED_ARCH 改成 "amd64 arm64"
# 并先在 CI 里跑一遍 amd64 构建（build.sh 有逐文件 ELF 架构断言，错了会当场失败，
# 不会打出坏包）。当前真机是 RK3588，用户明确不需要 x86。
