APP_ID=com.personal.postgresql17
PROJECT_DIR=apps/postgresql/com.personal.postgresql17
FILE_PREFIX=postgresql17
RELEASE_TITLE="PostgreSQL 17"
HOMEPAGE_URL="https://www.postgresql.org"
SUPPORTED_ARCH="amd64 arm64"
# postgres/postgres 不发 GitHub Release 正文，fetch-upstream-notes 拿不到内容
# 是预期 —— 这个字段只用来在 Release 说明里给出上游仓库链接。
UPSTREAM_GITHUB=postgres/postgres

# 版本方案与其它 app 不同：不跟随 pgdg 的小版本号（17.x），沿用桌面工程自己的
# 1.0.x 应用版本线（人工 bump）。bundled 的数据库小版本 = 构建当天 pgdg 索引里
# 的最新 17.x（fetch-runtime.py --pg-major 17 自动挑）。
# 要刷新 bundled 小版本：bump project.yaml 的 version 再触发构建——
# 版本字符串没变时 CI 按"已发布"跳过，不会自己动。
