APP_ID=com.personal.zhiyinmusic
PROJECT_DIR=apps/zhiyinmusic/com.personal.zhiyinmusic
FILE_PREFIX=zhiyinmusic
RELEASE_TITLE="知音音乐 Zhiyin Music"
HOMEPAGE_URL="https://github.com/qwex888/zhiyin-music"
SUPPORTED_ARCH="amd64 arm64"
# 上游【只发 Docker 镜像】：GitHub 那个仓库里只有 README、config.toml.example 和
# docker-compose.yml，Rust 源码一行都没有，也没有 Release、没有 tag。
# 所以版本源是 Docker Hub 的镜像 tag（见 get-latest-version.sh），
# 而 build.sh 是按 manifest digest 把镜像层拉下来解包。
#
# 这里仍设 UPSTREAM_GITHUB 是为了让 Release 正文里有「上游仓库」这一行链接 ——
# 拿不到正文时 reusable-build-app.yml 会自己把那个指向具体 tag 的链接清掉，
# 不会留下 404。上游也没有 CHANGELOG.md（更新日志在镜像内的
# releases/releases.json 里，不是 markdown），所以不设 CHANGELOG_URL。
UPSTREAM_GITHUB="qwex888/zhiyin-music"
