APP_ID=com.superng6.qbittorrent
PROJECT_DIR=apps/qbittorrent-ng6/com.superng6.qbittorrent
FILE_PREFIX=qbittorrent-ng6
RELEASE_TITLE="qBittorrent (superng6)"
HOMEPAGE_URL="https://hub.docker.com/r/superng6/qbittorrent"
SUPPORTED_ARCH="amd64 arm64"
# 上游的发布渠道是 Docker Hub 镜像 superng6/qbittorrent，不是 GitHub Release
# （SuperNG6/docker-qbittorrent 仓库里只有 Dockerfile 和构建脚本，没有 Release）。
# 版本探测走 Docker Hub 的 tag 列表，见 get-latest-version.sh。
# 这里仍设 UPSTREAM_GITHUB 是为了让 Release 正文里有「上游仓库」这一行链接；
# 拿不到正文时 reusable-build-app.yml 会把指向具体 tag 的链接清掉，不会留 404。
UPSTREAM_GITHUB="SuperNG6/docker-qbittorrent"
