APP_ID=com.oplist.openlist
PROJECT_DIR=apps/openlist/com.oplist.openlist
FILE_PREFIX=openlist
RELEASE_TITLE="OpenList"
HOMEPAGE_URL="https://doc.oplist.org/"
SUPPORTED_ARCH="amd64 arm64"
UPSTREAM_GITHUB=OpenListTeam/OpenList
# 用 musl 版资产（openlist-linux-musl-<arch>.tar.gz）而不是默认的 glibc 版：
# 前者是【静态链接】、后者是动态链接（file 实测确认）。原生应用沙箱的文件系统
# 视图极窄，静态二进制零运行时依赖最稳；顺带 musl 的 resolver 内置了 localhost
# 特例，不受"沙箱没有 /etc/hosts"影响。见 build.sh 注释。
# Go 1.27 起,运行时对环境里"已移除的 GODEBUG 项设为旧值"直接 fatal(见 start.sh 第 0 节)。
# UGOS 的 systemd 全局配置注入 DefaultEnvironment="GODEBUG=tlskyber=0" —— 正中枪口。
# 本包用上游预编译二进制,没法控制编译期;start.sh 在 exec 前消毒 GODEBUG。
