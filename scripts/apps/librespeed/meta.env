APP_ID=com.personal.librespeed
PROJECT_DIR=apps/librespeed/com.personal.librespeed
FILE_PREFIX=librespeed
RELEASE_TITLE="网速测试 LibreSpeed"
HOMEPAGE_URL="https://github.com/librespeed/speedtest-go"
SUPPORTED_ARCH="amd64 arm64"
UPSTREAM_GITHUB=librespeed/speedtest-go
# 测速工具归 utility（商店分类枚举里的“实用工具”）；不写会按 tag_types=utility
# 落到 TAG_TYPE_MAP 的 system。
CATALOG_CATEGORY=utility
#
# 上游是 LibreSpeed 官方 Go 后端 speedtest-go（LGPL-3.0）。CI 按 tag 现场克隆源码
# 交叉编译（上游 release 的 Linux 二进制经 goreleaser upx -9 压壳，沙箱自解压行为
# 未验证，不走预编译资产）；自写 Go 管理壳（launcher）源码随本仓库
# apps/librespeed/server/ 维护，前端中文页 apps/librespeed/assets-ui/index.html。
