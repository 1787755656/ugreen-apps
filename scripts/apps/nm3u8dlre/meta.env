# 构建契约（被 build.sh / get-latest-version.sh source，也被 generate-catalog.py 白名单解析）
# 注意：这几个 key 不要加空格、不要用变量拼接，否则 catalog 解析不到。

APP_ID=com.personal.nm3u8dlre
PROJECT_DIR=apps/nm3u8dlre/com.personal.nm3u8dlre
FILE_PREFIX=nm3u8dlre
RELEASE_TITLE="m3u8下载器 (N_m3u8DL-RE)"
HOMEPAGE_URL="https://github.com/Youngxj/N_m3u8DL-RE-FN"
SUPPORTED_ARCH="amd64 arm64"
CATALOG_CATEGORY=download

# 上游清单：
#   Youngxj/N_m3u8DL-RE-FN —— fnOS 版 Web 界面（本项目的前端来源，MIT）
#   nilaoda/N_m3u8DL-RE   —— 下载引擎本体（Release 提供 linux-x64 / linux-arm64 单文件二进制，MIT）
UPSTREAM_GITHUB=nilaoda/N_m3u8DL-RE
UI_UPSTREAM=Youngxj/N_m3u8DL-RE-FN
