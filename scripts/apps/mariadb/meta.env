APP_ID=com.personal.mariadb
PROJECT_DIR=apps/mariadb/com.personal.mariadb
FILE_PREFIX=mariadb
RELEASE_TITLE="MariaDB"
HOMEPAGE_URL="https://mariadb.org"
SUPPORTED_ARCH="amd64 arm64"
# MariaDB/server 没有 GitHub Release 正文，fetch-upstream-notes 拿不到内容是
# 预期行为 —— 这个字段只用来在 Release 说明里给出上游仓库链接。
UPSTREAM_GITHUB=MariaDB/server

# 首发钉在真机验证过的版本（独立仓库时期打到 11.4.12.0009）。删掉这一行
# 即恢复自动跟踪 11.4 系列最新版（当前 archive.mariadb.org 已有 11.4.13）。
# 数据库应用采用"先真机、再放行"的保守策略：11.4.x 的 deb 布局虽稳定，
# 但每个小版本第一次进商店前应有人在真机上装过。
PINNED_VERSION=11.4.12
