# Backend binaries are downloaded/assembled fresh by CI
# (scripts/apps/*/build.sh) into these directories — never commit them.
# Keeps the repo small regardless of how many upstream releases we track
# over time. See README.md for the reasoning (borrowed from conversun/fnos-apps,
# whose .fpk output likewise never enters git — only GitHub Releases).
apps/*/*/rootfs_amd64/
apps/*/*/rootfs_arm64/

# ugcli packaging output (upk files + intermediate tar/config) — only ever
# uploaded to GitHub Releases, never committed.
apps/*/*/build_dir/

# Locally packed upk files ready for manual install on the NAS — same
# artifacts CI publishes to GitHub Releases, so never committed either.
dist/

# 自带的 IP 地理数据库由 CI 现场下载（DB-IP 按月发布，4MB 二进制不进 git）；
# 同目录的 ATTRIBUTION.txt 是要提交的（CC BY 4.0 要求署名）。
apps/*/*/rootfs_common/geoip/*.mmdb.gz

.DS_Store

# 打包成品只进 GitHub Releases，不进 git（根目录的本地手工构建产物）
*.upk

# 拾光便签的前端 (rootfs_common/www) 由 build.sh 现场从上游 vite 产物生成
apps/shiguangnotes/com.personal.shiguangnotes/rootfs_common/www/

# clouddl 的前端 (rootfs_common/www) 由 build.sh 现场从上游生成（上游 static
# 拷贝 + UGOS 认证适配层 + 文案 patch），跟着上游 tag 走，不进 git。
apps/clouddl/com.personal.clouddl/rootfs_common/www/

# 本地调试 clouddl build.sh 时落在脚本旁的下载缓存（CI 上用 RUNNER_TEMP）。
scripts/apps/clouddl/.build-cache/

# LunaTV 采集源配置 —— 本地留存不上传（用户要求），导入脚本见同目录
scripts/apps/lunatv/sources.local.json
scripts/apps/lunatv/.build-cache/

# piggybank 本地调试缓存（CI 用 RUNNER_TEMP）
scripts/apps/piggybank/.build-cache/

# 100zip 的前端 (rootfs_common/www) 由 build.sh 现场从上游生成（上游 www 拷贝
# + UGOS 认证适配层 + 文案 patch），跟着上游 tag 走，不进 git。
apps/100zip/com.personal.100zip/rootfs_common/www/

# 本地调试 100zip build.sh 时落在脚本旁的下载缓存（CI 上用 RUNNER_TEMP）。
scripts/apps/100zip/.build-cache/

# it-tools 的前端 (rootfs_common/www) 由 build.sh 现场从上游 release zip 解包
# （上游 CI bot 随 release 发的 dist），跟着上游 tag 走，不进 git。
apps/it-tools/com.personal.ittools/rootfs_common/www/

# 本地调试 it-tools build.sh 时落在脚本旁的下载缓存（CI 上用 RUNNER_TEMP）。
scripts/apps/it-tools/.build-cache/

# MariaDB 的管理页前端由 build.sh 从 launcher/web 现场同步（单一来源原则，
# 真身在 scripts/apps/mariadb/launcher/web/），不进 git。
apps/mariadb/com.personal.mariadb/rootfs_common/www/

# MariaDB build.sh 的本地缓存（Go 工具链 + deb 下载缓存；CI 上同样落在脚本旁，
# runner 一次性用完即弃）。
scripts/apps/mariadb/.build-cache/

# Octop 的前端 (rootfs_common/www) 由 build.sh 现场从上游 fpk 里的
# site-packages/octop/dashboard 铺出来（前后端同版本、单一来源），不进 git。
apps/octop/com.tencent.octop/rootfs_common/www/

# redis / postgresql 的 build.sh 本地缓存（同上：Go 工具链 + deb 下载缓存）。
# 两应用的管理页前端是直接提交的静态文件，无需 ignore。
scripts/apps/redis/.build-cache/
scripts/apps/postgresql/.build-cache/

# nm3u8dlre build.sh 的本地下载缓存（引擎 tar.gz / 静态 ffmpeg；CI 用 RUNNER_TEMP）。
# 注意 rootfs_common/www 是【入库】的成品：上游 fnOS 界面经 patch-ui.py 改造后
# 直接提交，保证每次构建的前端完全一致，所以不要 ignore。
scripts/apps/nm3u8dlre/.build-cache/

# deenmusic build.sh 的本地下载缓存（上游源码、CPython、npm/pkg 缓存；CI 用 RUNNER_TEMP）。
# rootfs_common/www 只有一个静态跳转页，是【入库】的成品，不要 ignore。
scripts/apps/deenmusic/.build-cache/
# 本机（WorkBuddy 沙箱）跑构建用的 rm 包装器，不提交
scripts/apps/deenmusic/.tmp-local-build.sh

# Trilium 的 app/ 主体（上游 Server 独立包约 171MB 的 dist：main.mjs/chunks/public/
# assets/node_modules）由 build.sh 现场从上游 tar.xz 铺出来，跟着上游版本走，不进 git；
# 入库的只有 project.yaml、icon、www 占位页和 bin/bootstrap.mjs。
apps/trilium/com.personal.trilium/rootfs_common/app/

# Trilium build.sh 的本地下载缓存（上游 Server 独立包 tar.xz + 解压目录；CI 用 RUNNER_TEMP）。
scripts/apps/trilium/.build-cache/
